# ── Backend ──────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cctv_planner?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-64-char-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
INVITE_TOKEN_TTL_HOURS=72

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme

CAMERA_IMAGE_MAX_UPLOAD_BYTES=5242880
CAMERA_IMAGE_MAX_SOURCE_WIDTH=2000
CAMERA_IMAGE_MAX_SOURCE_HEIGHT=2000
CAMERA_IMAGE_MAX_DECODED_PIXELS=4000000
CAMERA_MODEL_ARCHIVE_MAX_UPLOAD_BYTES=8388608
CAMERA_MODEL_ARCHIVE_MAX_DECOMPRESSED_BYTES=8388608
CAMERA_MODEL_ARCHIVE_MAX_JSON_BYTES=65536
CAMERA_MODEL_ARCHIVE_MAX_JSON_DEPTH=10
CAMERA_MODEL_ARCHIVE_VALIDATION_TIMEOUT_SECONDS=10

# ── Frontend (Vite build-time) ────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
VITE_STADIA_MAPS_API_KEY=replace-with-your-stadia-key
VITE_MARTIN_TILE_SERVER_URL=http://localhost:3000
